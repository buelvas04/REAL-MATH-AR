# Copiar como .env SOLO en el computador/servidor que ejecuta el proyecto.
# No publicar .env, la base de datos ni los registros de recuperación.
APP_ENV=development
DATABASE_PATH=data/real_math_ar.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# En producción: APP_ENV=production, HTTPS y COOKIE_SECURE=true.
# Para enviar correos de recuperación reales necesitas SMTP autorizado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Investigador habilitado a exportar el estudio piloto seudonimizado.
ADMIN_EMAILS=
